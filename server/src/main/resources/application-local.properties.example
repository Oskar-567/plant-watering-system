# Copy this file to application-local.properties and fill in your values.
# application-local.properties is gitignored.

DB_USERNAME=plant
DB_PASSWORD=secret

# HMAC signing key for JWTs, used as raw UTF-8 bytes — must be at least 32 characters.
# Generate a random one, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-local-dev-jwt-secret-min-32-chars
APP_PASSWORD=changeme

MQTT_BROKER=192.168.x.x
MQTT_USERNAME=
MQTT_PASSWORD=
